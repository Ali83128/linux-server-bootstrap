# Managed by linux-server-bootstrap. Local edits are overwritten on the next run.
[sshd]
enabled  = true
port     = {{SSH_PORTS}}
backend  = systemd
maxretry = 5
findtime = 10m
bantime  = 1h
# Repeat offenders are banned for longer each time (up to one week).
bantime.increment = true
bantime.maxtime   = 1w
